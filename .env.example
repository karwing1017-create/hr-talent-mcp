# ═══ PostgreSQL 数据仓库连接配置 ═══
DW_HOST=your_database_host
DW_PORT=5432
DW_DATABASE=your_database_name
DW_USER=readonly_user
DW_PASSWORD=your_password_here

# 数据表 schema 前缀
DW_SCHEMA_DWRDIM=DWRDIM
DW_SCHEMA_DWRHR=DWRHR
DW_SCHEMA_DM=DM

# ═══ MCP 传输模式配置 ═══
# stdio    = 本地模式（单人使用，WorkBuddy/HiAgent 通过子进程调用）
# sse      = 远程 SSE 模式（兼容旧客户端）
# streamable-http = 远程 HTTP 模式（推荐，多人共享）
MCP_TRANSPORT=stdio

# HTTP 模式监听地址（远程部署设 0.0.0.0）
MCP_HOST=127.0.0.1

# HTTP 模式监听端口
MCP_PORT=8000

# ═══ API Key 认证（HTTP 模式必填）═══
# 逗号分隔的合法 API Key 列表
# 每个同事分配一个独立 key，便于审计和吊销
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=

# ═══ 日志级别 ═══
LOG_LEVEL=INFO
